# ------------------------------------------------------------------------------
# 3. BANCO DE DADOS NA MÁQUINA VIRTUAL ORACLE CLOUD (OCI ALWAYS FREE)
# Ao configurar o PostgREST na sua VM na Oracle Cloud, preencha abaixo com o IP
# público da sua VM na porta 8000 (ou o seu domínio com SSL HTTPS):
# ------------------------------------------------------------------------------
VITE_OCI_API_URL="http://SEU_IP_PUBLICO_OCI:8000"
VITE_OCI_ANON_KEY="porttohub_oci_default_anon_token"

